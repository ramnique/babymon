# Your public hostname (the domain your reverse proxy serves babymon on).
PUBLIC_HOST=babymon.example.com

# Shared secret between the app and coturn for ephemeral TURN credentials.
# Generate one:  openssl rand -hex 32
TURN_SECRET=change-me

# Optional overrides:
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_TTL_SECONDS=21600

# --- Optional: HTTP Basic Auth in front of the whole app -------------------
# Adds a username/password wall (browser popup) before anything loads — the
# app, and the signaling WebSocket that hands out TURN credentials. Each
# family device enters it once. Leave commented for no password (default).
#
# 1. Generate a password hash:
#      docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# 2. Uncomment all three lines. Keep the SINGLE QUOTES around the hash —
#    without them docker compose interpolates the $... parts and silently
#    corrupts it (you'd also see "variable is not set" warnings):
#
# CADDY_VARIANT=.auth
# BASIC_AUTH_USER=parent
# BASIC_AUTH_HASH='$2a$14$replace-with-your-generated-hash'
